# Copia questo file in .streamlit/secrets.toml (in locale) e compila i valori
# ottenuti dal tuo database Turso. NON committare mai secrets.toml su GitHub:
# è già escluso in .gitignore.
#
# Su Streamlit Cloud NON serve questo file: incolla le stesse due righe
# nella sezione "Secrets" delle impostazioni dell'app (vedi README.md).

TURSO_DATABASE_URL = "libsql://il-tuo-db-nomeorg.turso.io"
TURSO_AUTH_TOKEN = "il-tuo-token"
